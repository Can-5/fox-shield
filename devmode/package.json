{
  "name": "fox-shield-devmode",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "fox-shield Developer Mode — private PC dark-list viewer (localhost:8788)",
  "scripts": {
    "dev": "concurrently -k \"bun run dev:server\" \"bun run dev:web\"",
    "dev:web": "bun node_modules/vite/bin/vite.js",
    "dev:server": "bun run server.ts",
    "build": "bun node_modules/typescript/bin/tsc --noEmit && bun node_modules/vite/bin/vite.js build",
    "start": "bun run server.ts"
  },
  "dependencies": {
    "hono": "^4.4.0",
    "preact": "^10.22.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.8.0",
    "@types/node": "^20.14.0",
    "concurrently": "^8.2.2",
    "typescript": "^5.4.0",
    "vite": "^5.3.0"
  }
}
