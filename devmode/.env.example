# fox-shield Developer Mode — environment example
# Copy to .env and set your token. The server rejects requests without it.

# Zorunlu: admin token. Asla public'e koyma.
DEV_TOKEN=change-me

# Cihaz bağlama: ilk çalıştırmada otomatik üretilir (devmode/.device_id).
# İstersen elle de verebilirsin — aynı değer tarayıcıda X-Device-Id olarak gönderilir.
# DEVICE_ID=

# Yerel modda (varsayılan) false kalır → yalnızca localhost erişir.
# Cloud deploy için true yap (wrangler.toml [vars] içinde de tanımlanır).
ALLOW_REMOTE=false

# Cloudflare deploy için (wrangler secret put CLOUDFLARE_TOKEN ile set et).
# CLOUDFLARE_TOKEN=

# İsteğe bağlı: gerçek Redis'e (LXC origin) bağlanmak yerine mock veri kullanma.
# REDIS_URL=redis://localhost:6379

# İsteğe bağlı: ek CORS origin'leri (virgülle ayır).
# ALLOWED_ORIGINS=https://fox-shield-dev.workers.dev
